# Public client-side configuration for local development.
# Copy this file to .env.local and fill in the values.
# Never put service-role keys, API tokens, or other secrets in VITE_* variables.

VITE_SANITY_PROJECT_ID=YOUR_SANITY_PROJECT_ID
VITE_SANITY_DATASET=production
VITE_SANITY_PLANTS_DATASET=plants
