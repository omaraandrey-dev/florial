            "_type": "block",
            "children": [
              {
                "_key": "HE1201-en-s11",
                "_type": "span",
                "marks": [],
                "text": "Compatible with Rain Bird 1800 and UNI-Spray sprinklers and Rain Bird shrub adapters. A filter screen is included. Recommended spacing is 1.8–4.6 m, depending on the model and pressure. Matched precipitation allows HE-VAN nozzles to be used with MPR and U-Series nozzles."
              }
            ],
            "markDefs": [],
            "style": "normal"
