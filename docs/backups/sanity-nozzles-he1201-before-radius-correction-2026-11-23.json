                "marks": [
                  "strong"
                ],
                "text": "Irrigation radius: 2.7–3.7 m."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "HE1201-en-b4",
            "_type": "block",
            "children": [
              {
                "_key": "HE1201-en-s5",
                "_type": "span",
                "marks": [
                  "strong"
                ],
                "text": "Adjustable arc: 0°–360°."
              }
            ],
