            "markDefs": [],
            "style": "h2"
          },
          {
            "_key": "HE1201-en-b1",
            "_type": "block",
            "children": [
              {
                "_key": "HE1201-en-s2",
                "_type": "span",
                "marks": [],
                "text": "Rain Bird HE-VAN-12 is a high-efficiency adjustable spray nozzle for lawns and landscaped areas. Its specially designed spray pattern provides even water distribution and improved wind resistance."
              }
            ],
            "markDefs": [],
            "style": "normal"
          },
          {
