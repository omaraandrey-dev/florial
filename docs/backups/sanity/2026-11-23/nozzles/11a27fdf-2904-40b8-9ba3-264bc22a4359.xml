      <formattedDescription>
        <_key>11a27fdf-2904-40b8-9ba3-264bc22a4359-ru-p3</_key>
        <_type>block</_type>
        <children>
          <_key>11a27fdf-2904-40b8-9ba3-264bc22a4359-ru-p3s0</_key>
