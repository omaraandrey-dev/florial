        <_type>block</_type>
        <children>
          <_key>11a27fdf-2904-40b8-9ba3-264bc22a4359-en-h5s0</_key>
          <_type>span</_type>
          <text>Design, installation and maintenance</text>
        </children>
        <style>h2</style>
      </formattedDescription>
      <formattedDescription>
        <_key>11a27fdf-2904-40b8-9ba3-264bc22a4359-en-p5</_key>
        <_type>block</_type>
        <children>
          <_key>11a27fdf-2904-40b8-9ba3-264bc22a4359-en-p5s0</_key>
          <_type>span</_type>
          <marks>strong</marks>
          <text>For system design: </text>
        </children>
        <children>
          <_key>11a27fdf-2904-40b8-9ba3-264bc22a4359-en-p5s1</_key>
          <_type>span</_type>
          <text>provide adequate head-to-head coverage and check dynamic pressure at the nozzle. Explore the </text>
        </children>
        <children>
          <_key>11a27fdf-2904-40b8-9ba3-264bc22a4359-en-p5s2</_key>
          <_type>span</_type>
          <marks>category</marks>
          <text>spray nozzles</text>
        </children>
        <children>
          <_key>11a27fdf-2904-40b8-9ba3-264bc22a4359-en-p5s3</_key>
          <_type>span</_type>
          <text>; also read </text>
