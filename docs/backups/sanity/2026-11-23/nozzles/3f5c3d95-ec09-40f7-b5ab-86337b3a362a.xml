          <text>Размеры и технические параметры</text>
        </children>
        <style>h2</style>
      </formattedDescription>
      <formattedDescription>
        <_key>3f5c3d95-ec09-40f7-b5ab-86337b3a362a-ru-p2</_key>
        <_type>block</_type>
        <children>
