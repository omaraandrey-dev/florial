          <text>Для каких участков подходит</text>
        </children>
        <style>h2</style>
      </formattedDescription>
      <formattedDescription>
        <_key>a6e7016e-7bba-4078-b76c-6afef30661d6-ru-p1</_key>
        <_type>block</_type>
        <children>
