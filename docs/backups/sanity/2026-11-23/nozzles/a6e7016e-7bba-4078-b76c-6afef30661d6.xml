      <formattedDescription>
        <_key>a6e7016e-7bba-4078-b76c-6afef30661d6-ru-p3</_key>
        <_type>block</_type>
        <children>
          <_key>a6e7016e-7bba-4078-b76c-6afef30661d6-ru-p3s0</_key>
