        </children>
        <children>
          <_key>b01</_key>
          <_type>span</_type>
          <text> — a ¾″ diaphragm solenoid valve for automatic irrigation.</text>
        </children>
        <style>normal</style>
      </formattedDescription>
      <formattedDescription>
        <_key>h1</_key>
        <_type>block</_type>
        <children>
          <_key>h10</_key>
