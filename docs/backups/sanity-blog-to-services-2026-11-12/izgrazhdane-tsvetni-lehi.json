            ],
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "bey",
            "_type": "block",
            "children": [
              {
                "_key": "bex",
                "_type": "span",
                "marks": [],
                "text": "За подобряване на съществуващия чернозем могат да се използват:"
