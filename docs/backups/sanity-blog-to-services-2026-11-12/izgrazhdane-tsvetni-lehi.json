            "level": 1,
            "listItem": "bullet",
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "bdk",
            "_type": "block",
            "children": [
              {
                "_key": "bdj",
                "_type": "span",
                "marks": [],
                "text": "Разработваме ландшафтен проект с опис на цъфтящите растения;"
              }
            ],
            "level": 1,
            "listItem": "bullet",
            "markDefs": [],
            "style": "normal"
          },
          {
            "_key": "bdm",
            "_type": "block",
            "children": [
              {
                "_key": "bdl",
                "_type": "span",
                "marks": [],
                "text": "Очертаваме цветната градина на място според утвърдения проект;"
